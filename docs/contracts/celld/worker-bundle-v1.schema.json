{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sandbox.aiwg.io/contracts/celld/worker-bundle/v1",
  "title": "worker-celld bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "name", "version", "entrypoint", "digest", "capabilities", "limits", "tenancy"],
  "properties": {
    "api_version": { "const": "worker-celld.agentic-sandbox/v1" },
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "entrypoint": { "type": "string", "pattern": "^[^/].*\\.(m?js|wasm)$" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "signature": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["kind", "identity", "bundle"],
      "properties": {
        "kind": { "enum": ["sigstore", "ed25519"] },
        "identity": { "type": "string", "minLength": 1 },
        "bundle": { "type": "string", "minLength": 1 }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["worker.fetch", "worker.rpc", "durable.storage", "durable.alarm", "websocket.inbound", "network.outbound.fetch", "wasm.module", "assets.static"] }
    },
    "outbound_http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_origins"],
      "properties": {
        "allowed_origins": { "type": "array", "uniqueItems": true, "items": { "type": "string", "format": "uri" } }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu_ms_per_request", "memory_mb", "requests_per_minute", "storage_mb", "resident_cells"],
      "properties": {
        "cpu_ms_per_request": { "type": "integer", "minimum": 1 },
        "memory_mb": { "type": "integer", "minimum": 1 },
        "requests_per_minute": { "type": "integer", "minimum": 1 },
        "storage_mb": { "type": "integer", "minimum": 1 },
        "resident_cells": { "type": "integer", "minimum": 1 }
      }
    },
    "tenancy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust_domain", "hostile_multi_tenant"],
      "properties": {
        "trust_domain": { "type": "string", "minLength": 1 },
        "hostile_multi_tenant": { "const": false }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "celld_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "compatibility_date": { "type": "string", "format": "date" }
      }
    }
  }
}
