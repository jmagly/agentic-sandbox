  "rationale": {
    "intentionally_api_only": "Health, metrics, enrollment, credential proxy, MCP transport, activity ingest, and Celld effect callbacks are machine-to-machine or probe surfaces and must not expose generic dashboard mutation controls.",
    "capability_unavailable": "Reserved for a dashboard action whose backing route is absent at runtime; controls fail closed after capability discovery.",
    "temporary_v1": "Compatibility-only dashboard paths retain Sunset/deprecation telemetry and must not receive new domain functionality."
  }
