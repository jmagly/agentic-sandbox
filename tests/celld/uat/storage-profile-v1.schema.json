{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sandbox.dev/schemas/celld-storage-profile/v1",
  "title": "Provider-neutral Celld storage qualification profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "run_id", "dialect", "scope", "endpoint", "region", "addressing_mode", "bucket", "run_prefix", "identity_file_ref", "backend", "limits"],
  "properties": {
    "schema_version": { "const": "agentic-sandbox.celld-storage-profile/v1" },
    "profile_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "dialect": { "enum": ["s3-v1", "gcs-reserved"] },
    "scope": { "enum": ["fixture_reduced", "live_candidate"] },
    "endpoint": { "type": "string", "format": "uri" },
    "region": { "type": "string", "minLength": 1 },
    "addressing_mode": { "const": "path" },
    "bucket": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$" },
    "run_prefix": { "type": "string", "minLength": 1 },
    "identity_file_ref": { "type": "string", "pattern": "^/" },
    "ca_file_ref": { "type": "string", "pattern": "^/" },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "version", "artifact_sha256", "configuration_sha256", "gateway_endpoints", "topology"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "configuration_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gateway_endpoints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uri" } },
        "topology": { "type": "string", "minLength": 1 }
      }
    },
    "limits": { "$ref": "#/$defs/limits" }
  },
  "$defs": {
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create_rounds", "overwrite_rounds", "contenders", "warmups", "max_workers", "max_connections"],
      "properties": {
        "create_rounds": { "type": "integer", "minimum": 1 },
        "overwrite_rounds": { "type": "integer", "minimum": 1 },
        "contenders": { "type": "integer", "minimum": 2 },
        "warmups": { "type": "integer", "minimum": 0 },
        "max_workers": { "type": "integer", "minimum": 1, "maximum": 32 },
        "max_connections": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    }
  }
}
