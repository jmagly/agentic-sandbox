{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sandbox.dev/schemas/celld-crash-phase-evidence/v1",
  "title": "Celld independently timed crash phase evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id_sha256", "phase", "observer", "management_pid", "reached_at"],
  "properties": {
    "schema_version": { "const": "agentic-sandbox.celld-crash-phase-evidence/v1" },
    "operation_id_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "phase": { "enum": ["before_dispatch", "during_dispatch", "after_dispatch"] },
    "observer": { "enum": ["management_process_absent", "management_dispatch_gate"] },
    "management_pid": { "type": "integer", "minimum": 1 },
    "reached_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "phase": { "const": "before_dispatch" } }, "required": ["phase"] },
      "then": { "properties": { "observer": { "const": "management_process_absent" } } },
      "else": { "properties": { "observer": { "const": "management_dispatch_gate" } } }
    }
  ]
}
