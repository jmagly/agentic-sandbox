{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sandbox.dev/schemas/celld-qualification-readiness/v1",
  "title": "Celld consolidated qualification readiness evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ready", "lane", "git", "checks", "scenarios", "assertions", "drivers", "dependencies", "profiles", "generated_at"],
  "properties": {
    "schema_version": { "const": "agentic-sandbox.celld-qualification-readiness/v1" },
    "ready": { "type": "boolean" },
    "lane": { "enum": ["complete", "issue-764", "issue-765", "issue-767", "issue-771"] },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "actual"],
      "properties": { "expected": { "$ref": "#/$defs/git" }, "actual": { "$ref": "#/$defs/git" } }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "status": { "enum": ["PASS", "FAIL"] },
          "evidence": {}
        }
      }
    },
    "scenarios": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^UAT-CELLD-0(?:0[3-9]|1[0-5])$" } },
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "assertion_id", "owners", "owner_count", "formula"],
        "properties": {
          "scenario_id": { "type": "string", "pattern": "^UAT-CELLD-0(?:0[3-9]|1[0-5])$" },
          "assertion_id": { "type": "string", "pattern": "^CELLD\\.[A-Z0-9_.-]+$" },
          "owners": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "owner_count": { "type": "integer", "minimum": 0 },
          "formula": { "enum": ["trusted", "candidate_withheld", "missing", "supporting_executor"] }
        }
      }
    },
    "drivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "id", "path", "installed"],
        "properties": {
          "key": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "pattern": "^celld-live-[a-z0-9-]+$" },
          "path": { "type": "string", "pattern": "^scripts/[A-Za-z0-9._-]+$" },
          "installed": { "type": "boolean" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue", "exact_git", "sources", "acceptable"],
        "properties": {
          "issue": { "type": "string", "pattern": "^#7(?:6[3-9]|7[0-1])$" },
          "exact_git": { "$ref": "#/$defs/git" },
          "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
          "acceptable": { "type": "boolean" }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "present", "enabled", "config_path"],
        "properties": {
          "id": { "type": "string", "pattern": "^celld-live-[a-z0-9-]+$" },
          "present": { "type": "boolean" },
          "enabled": { "type": "boolean" },
          "config_path": { "type": ["string", "null"] }
        }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "git": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "exists", "regular_file", "symlink"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "exists": { "type": "boolean" },
        "regular_file": { "type": "boolean" },
        "symlink": { "type": "boolean" }
      }
    }
  }
}
