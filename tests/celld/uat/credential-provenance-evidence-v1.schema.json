{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-sandbox.dev/schemas/celld-credential-provenance-evidence/v1",
  "title": "Celld credential, provenance, rotation, and leakage evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "protected_credentials", "lifecycles", "scope", "hmac", "provenance", "scans", "pins", "expected_inventory_sha256", "cleanup"],
  "properties": {
    "schema_version": { "const": "agentic-sandbox.celld-credential-provenance-evidence/v1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "protected_credentials": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["secret_kind", "credential_id_sha256", "credential_ref_sha256", "canary_id_sha256", "delivery", "owner_only", "canary_matches_in_reference", "canary_matches_outside_reference"]
      }
    },
    "lifecycles": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["secret_kind", "owner", "consumer", "delivery", "activation_method", "delivered_to_runtime", "activation_verified", "reload_proven", "overlap_ms", "revocation_verified", "failure_recovered", "evidence_id_sha256", "cleanup_verified"]
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_bucket_sha256", "other_bucket_sha256", "cases"],
      "properties": {
        "source_bucket_sha256": { "$ref": "#/$defs/hash" },
        "other_bucket_sha256": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
        "cases": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["case_id", "direction", "other_bucket_sha256", "credential_bucket_sha256", "target_bucket_sha256", "scope_kind", "attempts", "denied", "succeeded", "provider_effects"],
            "properties": {
              "case_id": { "type": "string", "minLength": 1, "maxLength": 256 },
              "direction": { "enum": ["source_identity_to_other_bucket", "other_identity_to_source_bucket"] },
              "other_bucket_sha256": { "$ref": "#/$defs/hash" },
              "credential_bucket_sha256": { "$ref": "#/$defs/hash" },
              "target_bucket_sha256": { "$ref": "#/$defs/hash" },
              "scope_kind": { "const": "other_fleet_bucket" },
              "attempts": { "type": "integer", "minimum": 1 },
              "denied": { "type": "integer", "minimum": 1 },
              "succeeded": { "const": 0 },
              "provider_effects": { "const": 0 }
            }
          }
        }
      }
    },
    "hmac": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hmac_canary_succeeded", "old_hmac_revoked_after_canary", "revoked_hmac_denied", "failed_canary_restored_original", "original_config_sha256", "candidate_config_sha256", "restored_config_sha256", "active_path_healthy"],
      "properties": {
        "hmac_canary_succeeded": { "const": true },
        "old_hmac_revoked_after_canary": { "const": true },
        "revoked_hmac_denied": { "const": true },
        "failed_canary_restored_original": { "const": true },
        "original_config_sha256": { "$ref": "#/$defs/hash" },
        "candidate_config_sha256": { "$ref": "#/$defs/hash" },
        "restored_config_sha256": { "$ref": "#/$defs/hash" },
        "active_path_healthy": { "const": true }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["mismatch_field", "approved_identity_before_sha256", "approved_identity_after_sha256", "candidate_identity_sha256", "approved_fields_sha256", "candidate_fields_sha256", "verifier", "verifier_executed", "verifier_result", "verifier_evidence_sha256", "install_attempts", "blocked_attempts", "install_effects", "response_code", "mismatch_detected"]
      }
    },
    "scans": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "expected_artifact_count", "artifacts_scanned", "expected_inventory_sha256", "scanned_inventory_sha256", "canaries_expected", "canaries_scanned", "canary_matches"],
        "properties": {
          "surface": { "enum": ["argv", "captured_env", "shell_trace", "logs", "crash_artifacts", "persistent_scratch", "support_evidence"] },
          "expected_artifact_count": { "type": "integer", "minimum": 1 },
          "artifacts_scanned": { "type": "integer", "minimum": 1 },
          "expected_inventory_sha256": { "$ref": "#/$defs/hash" },
          "scanned_inventory_sha256": { "$ref": "#/$defs/hash" },
          "canaries_expected": { "type": "integer", "minimum": 5 },
          "canaries_scanned": { "type": "integer", "minimum": 5 },
          "canary_matches": { "const": 0 }
        }
      }
    },
    "pins": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_pin_count", "unapproved_pin_count", "only_approved_pins_remain"],
      "properties": {
        "approved_pin_count": { "type": "integer", "minimum": 1 },
        "unapproved_pin_count": { "const": 0 },
        "only_approved_pins_remain": { "const": true }
      }
    },
    "expected_inventory_sha256": { "$ref": "#/$defs/hash" },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "unprotected_secret_files", "evidence_secret_findings", "all_disposable_secrets_removed"],
      "properties": {
        "status": { "const": "passed" },
        "unprotected_secret_files": { "const": 0 },
        "evidence_secret_findings": { "const": 0 },
        "all_disposable_secrets_removed": { "const": true }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
