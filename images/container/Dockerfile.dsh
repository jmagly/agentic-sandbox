# DeepSeek Harness (DSH) agent image — layers the dsh CLI (@deepseek-ai/dsh)
# on top of the shared dev toolchain (agent:dev). Operator session attaches
# drive `dsh --profile <name>` (the launcher forwards inner args verbatim);
# credential-aware launches go through agentic-dsh-automation.
#
# Model route: provider `openrouter` via pi-ai, model `stealth/ox-alpha`.
# Auth = OPENROUTER_API_KEY env resolved from the credential lease
# (AGENTIC_CREDENTIAL_DIR/openrouter_api_key). The baked DSH_HOME skeleton
# (images/container/dsh-home/) declares the model catalog with NO embedded
# credential — apiKeyEnv references the environment only.
#
# Build:
#   cd <repo-root>
#   docker build -f images/container/Dockerfile.base -t agentic/agent:base .
#   docker build -f images/container/Dockerfile.dev  -t agentic/agent:dev  .
#   docker build -f images/container/Dockerfile.dsh  -t agentic/dsh .
#
# (`build.sh` does the chain in order for you.)
#
# Issues: #175 (platform parity epic)
FROM agentic/agent:dev

LABEL org.agentic-sandbox.loadout="agentic-dev" \
      org.agentic-sandbox.image="agentic/dsh:latest" \
      org.agentic-sandbox.source="images/container/Dockerfile.dsh"

# Node comes from agent:dev (fnm-managed). `npm install -g` lands the dsh
# binary in fnm's node prefix; symlink it into /usr/local/bin so login shells
# find it without fnm shell-init. Pin tracked in ci/npm-pins.txt (#266).
# --ignore-scripts blocks lifecycle-script supply-chain attacks; the
# published package ships no lifecycle scripts (verified 2026-08-26).
RUN npm install -g --ignore-scripts @deepseek-ai/dsh@0.1.1-rc.2 \
 && ln -sf "$(npm prefix -g)/bin/dsh" /usr/local/bin/dsh \
 && dsh --version \
 && printf '%s\n' \
        '{"loadout":"agentic-dev","source":"images/container/Dockerfile.dsh","image_ref":"agentic/dsh:latest","tools":["aiwg","dsh","claude","codex","opencode","aider","gh","python3","node","go","cargo"],"helpers":["agentic-provider-inventory","agentic-provider-readiness","agentic-dsh-automation"]}' \
        > /etc/agentic-sandbox/loadout-manifest.json

# Worker DSH_HOME skeleton: static model catalog + default route, no secrets.
# AGENTIC_CREDENTIAL_DIR matches agent-rs credentials.rs DEFAULT_CREDENTIAL_DIR;
# the executor materializes leased secrets as files here (openrouter_api_key).
COPY images/container/dsh-home/ /var/lib/dsh/
ENV DSH_HOME=/var/lib/dsh \
    AGENTIC_CREDENTIAL_DIR=/run/agentic-sandbox/credentials

COPY images/common/automation-control/provider-inventory.sh /usr/local/bin/agentic-provider-inventory
COPY images/common/automation-control/provider-readiness.sh /usr/local/bin/agentic-provider-readiness
COPY images/common/automation-control/dsh-automation.sh /usr/local/bin/agentic-dsh-automation
RUN chmod +x \
        /usr/local/bin/agentic-provider-inventory \
        /usr/local/bin/agentic-provider-readiness \
        /usr/local/bin/agentic-dsh-automation \
 && agentic-provider-inventory dsh | grep -F 'schema	agentic.provider_inventory.v1' \
 && agentic-provider-readiness dsh | grep -F 'schema	agentic.provider_readiness.v1'

# Entrypoint inherited from base (tini → agent-entrypoint.sh → agent-client).
