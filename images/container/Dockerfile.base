# Agent base image — runs the agent-rs gRPC client inside a container so
# the management server can dispatch commands (including PTY) into it
# the same way it does for VM-hosted agents.
#
# v1 keeps this tiny: debian:trixie-slim + ca-certs + tini + an
# architecture-native agent-client binary. No platform-specific TUIs (claude /
# opencode / codex) — those are layered on top by per-platform
# Dockerfiles tracked under #175.
#
# Base note: trixie-slim ships glibc 2.41, which matches what CI / the
# typical dev host (Ubuntu 25.10, Debian trixie) link against. Bookworm
# (glibc 2.36) is too old — the prebuilt agent-client binary fails to
# load with `GLIBC_2.39 not found`. A static-musl build would let us
# drop back to a smaller base; tracked under #115.
#
# Build (BuildKit selects the target architecture for this stage):
#   docker buildx build --platform linux/amd64,linux/arm64 \
#     -f images/container/Dockerfile.base -t agentic/agent:base .
#
# Run (the management server's `POST /api/v1/containers` does this for you):
#   docker run -d --rm \
#     --label agentic-sandbox=true \
#     -e MANAGEMENT_SERVER=host.docker.internal:8120 \
#     -e AGENT_ID=test-agent \
#     -e AGENT_TRANSPORT=tls \
#     -e AGENT_GRPC_TLS_CA=/etc/agentic-sandbox/grpc-mtls/ca.pem \
#     -e AGENT_GRPC_TLS_CERT=/etc/agentic-sandbox/grpc-mtls/agent.pem \
#     -e AGENT_GRPC_TLS_KEY=/etc/agentic-sandbox/grpc-mtls/agent-key.pem \
#     --add-host host.docker.internal:host-gateway \
#     agentic/agent:base
#
# Secure transport provisions must provide AGENT_TRANSPORT plus matching
# AGENT_GRPC_* material. Legacy AGENT_SECRET bootstrap was retired in #412.
#
# Issue: #174 (PTY exec inside containers — Section C of #173).
# Current public CA bootstrap. The older pinned Rust/slim bases predate the
# active Let's Encrypt generation-Y chain served by Debian mirrors (#679).
FROM node:20@sha256:8f693eaa7e0a8e71560c9a82b55fd54c2ae920a2ba5d2cde28bac7d1c01c9ba5 AS ca-bootstrap

# Build the client inside the target-platform image. This prevents a binary
# built on the CI host from being copied into a different-architecture image.
FROM rust:1.88-bookworm@sha256:af306cfa71d987911a781c37b59d7d67d934f49684058f96cf72079c3626bfe0 AS agent-builder
COPY --from=ca-bootstrap /etc/ssl/certs/ /etc/ssl/certs/
COPY scripts/prepare-debian-apt-https.sh /tmp/prepare-debian-apt-https.sh
RUN sh /tmp/prepare-debian-apt-https.sh \
 && apt-get update \
 && apt-get install -y --no-install-recommends protobuf-compiler \
 && rm -f /tmp/prepare-debian-apt-https.sh \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY proto/ proto/
COPY agent-rs/ agent-rs/
WORKDIR /build/agent-rs
RUN cargo build --release --locked

# Digest pinned per ci/digests.txt (issue #262).
FROM debian:trixie-slim@sha256:109e2c65005bf160609e4ba6acf7783752f8502ad218e298253428690b9eaa4b

# Bootstrap verified HTTPS with the public CA trust store from the already-pinned
# builder image. The ca-certificates package below refreshes it in this stage.
COPY --from=ca-bootstrap /etc/ssl/certs/ /etc/ssl/certs/
COPY scripts/prepare-debian-apt-https.sh /tmp/prepare-debian-apt-https.sh

# ca-certs for outbound TLS (gRPC server may be wss/grpcs in future);
# tini as PID 1 so signals propagate cleanly to the agent and any PTY
# children it spawns (without tini, SIGTERM from `docker stop` doesn't
# always reach a process running under `bash -c`-style entrypoints).
# bash + coreutils give the operator a usable interactive shell when
# we exec-attach later.
RUN sh /tmp/prepare-debian-apt-https.sh \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        ca-certificates \
        tini \
        bash \
        coreutils \
        procps \
        tmux \
 && rm -f /tmp/prepare-debian-apt-https.sh \
 && rm -rf /var/lib/apt/lists/*

# Runtime identity used by the management service's mandatory --user flag.
# Do not set USER here: derived image builds still need root to add tools.
RUN groupadd --gid 10001 agent \
 && useradd --uid 10001 --gid 10001 --create-home --shell /bin/bash agent \
 && install -d -o 10001 -g 10001 /workspace

# Management launches containers with the mandatory numeric uid/gid rather
# than a Dockerfile USER directive. Declare the matching home and cwd here so
# every inherited image and direct `docker run --user 10001:10001` session has
# the same target-local defaults.
ENV HOME=/home/agent \
    USER=agent
WORKDIR /home/agent

COPY --from=agent-builder /build/agent-rs/target/release/agent-client /usr/local/bin/agent-client

# Entrypoint reads server / id / secure transport material from env. Defaults match the
# typical local-dev setup (host.docker.internal resolves to the docker
# host on Linux when --add-host host.docker.internal:host-gateway is
# passed). Bare `docker run` without env vars is a usage error.
COPY images/container/agent-entrypoint.sh /usr/local/bin/agent-entrypoint.sh
RUN chmod +x /usr/local/bin/agent-entrypoint.sh

# #625: operator-initiated reconnect helper. `docker exec <ctr> agent-reconnect`
# SIGHUPs the running agent-client so it re-registers without stopping the
# container. Every agent image inherits this entrypoint layer from base.
COPY images/container/agent-reconnect.sh /usr/local/bin/agent-reconnect
RUN chmod +x /usr/local/bin/agent-reconnect

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agent-entrypoint.sh"]
