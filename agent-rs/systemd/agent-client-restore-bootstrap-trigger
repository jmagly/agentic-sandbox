#!/usr/bin/env bash
set -euo pipefail

RESTORE_HOST_ADDRESS=""

if systemctl is-active --quiet agent-client.service; then
    systemctl stop --no-block agent-client-restore-bootstrap.timer
    exit 0
fi

mount_share() {
    local tag="$1" target="$2" options="$3"
    mountpoint -q "$target" && return 0
    mkdir -p "$target"
    mount -t virtiofs -o "$options" "$tag" "$target" >/dev/null 2>&1
}

configure_restore_network() {
    local bootstrap="$1" target_mac target_ip prefix interface interface_path
    target_mac="$(sed -n 's/^AGENT_RESTORE_MAC_ADDRESS=//p' "$bootstrap" | head -n1)"
    target_ip="$(sed -n 's/^AGENT_RESTORE_IP_ADDRESS=//p' "$bootstrap" | head -n1)"
    prefix="$(sed -n 's/^AGENT_RESTORE_IP_PREFIX=//p' "$bootstrap" | head -n1)"
    [[ "$target_mac" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] \
        || { echo "invalid restore MAC address" >&2; return 1; }
    [[ "$target_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && "$prefix" =~ ^([0-9]|[12][0-9]|3[0-2])$ ]] \
        || { echo "invalid restore IP address" >&2; return 1; }

    # Clean snapshots exclude the source NIC so every child can receive a
    # fresh MAC address. Cloud-init's generated networkd profile is commonly
    # MAC-bound, so it cannot configure that replacement device. Install a
    # restore-only, runtime profile and ask networkd to acquire DHCP before
    # enrollment starts. /run is intentionally ephemeral and never becomes
    # part of a later clean-base snapshot.
    interface=""
    for interface_path in /sys/class/net/en*; do
        [[ -e "$interface_path" ]] || continue
        interface="${interface_path##*/}"
        break
    done
    [[ -n "$interface" ]] || return 1
    ip link set dev "$interface" down
    ip address flush dev "$interface"
    ip link set dev "$interface" address "$target_mac"
    ip link set dev "$interface" up
    ip address add "$target_ip/$prefix" dev "$interface"
    [[ -z "$RESTORE_HOST_ADDRESS" ]] \
        || ip route replace default via "$RESTORE_HOST_ADDRESS" dev "$interface"

    # Enrollment needs the host bridge. Keep this bounded so a broken DHCP
    # server cannot wedge udev or the restore operation indefinitely.
    for _ in {1..20}; do
        ip -4 address show dev "$interface" | grep -q " $target_ip/$prefix " \
            && ip -4 route show default | grep -q . && return 0
        sleep 0.025
    done
    return 1
}

configure_restore_host_alias() {
    local bootstrap="$1" host_address
    host_address="$(sed -n 's/^AGENT_RESTORE_HOST_ADDRESS=//p' "$bootstrap" | head -n1)"
    if [[ -z "$host_address" ]]; then
        host_address="$(ip -4 route show default | awk 'NR == 1 { print $3 }')"
    fi
    [[ -n "$host_address" ]] || return 0
    if [[ "$host_address" == *[!0-9A-Fa-f:.]* ]]; then
        echo "refusing unsafe restore host address: $host_address" >&2
        exit 1
    fi
    RESTORE_HOST_ADDRESS="$host_address"

    # Keep hostname verification enabled for the management mTLS certificate.
    # This write is private to the restored child's COW filesystem.
    sed -i '/[[:space:]]host\.internal\([[:space:]]\|$\)/d' /etc/hosts
    printf '%s host.internal\n' "$host_address" >>/etc/hosts
}

wait_for_restore_enrollment_endpoint() {
    local bootstrap="$1" endpoint authority port
    endpoint="$(sed -n 's/^AGENT_BOOTSTRAP_ENROLLMENT_URL=//p' "$bootstrap" | head -n1)"
    authority="${endpoint#*://}"
    authority="${authority%%/*}"
    port="${authority##*:}"
    [[ "$port" =~ ^[0-9]+$ ]] || port=8122
    [[ -n "$RESTORE_HOST_ADDRESS" ]] || return 1

    for _ in {1..100}; do
        if timeout 0.1 bash -c 'exec 3<>/dev/tcp/"$1"/"$2"' \
            _ "$RESTORE_HOST_ADDRESS" "$port" 2>/dev/null; then
            return 0
        fi
        sleep 0.025
    done
    return 1
}

synchronize_restore_clock() {
    local bootstrap="$1" endpoint ca_path server_date
    endpoint="$(sed -n 's/^AGENT_BOOTSTRAP_ENROLLMENT_URL=//p' "$bootstrap" | head -n1)"
    ca_path="$(sed -n 's/^AGENT_BOOTSTRAP_CA=//p' "$bootstrap" | head -n1)"
    [[ "$endpoint" == https://* && -f "$ca_path" ]] || return 1

    # A paused memory snapshot freezes the guest wall clock. Obtain a signed
    # Date header from the pinned enrollment endpoint before validating the
    # freshly issued certificate's validity interval.
    server_date="$(curl --silent --show-error --head \
        --cacert "$ca_path" "$endpoint" 2>/dev/null \
        | sed -n 's/^[Dd]ate:[[:space:]]*//p' | tr -d '\r' | head -n1)"
    [[ -n "$server_date" ]] || return 1
    date --set="$server_date" >/dev/null
}

# Clean-base snapshots intentionally exclude vhost-user devices because their
# backend state is not safely restorable. The host hot-adds fresh child shares
# after the VMM restore API is ready; this short-lived timer mounts them.
mount_share agentinbox /mnt/inbox rw,nosuid,nodev || exit 0
mount_share agentoutbox /mnt/outbox rw,nosuid,nodev || true
mount_share agentglobal /mnt/agent-share ro,nosuid,nodev || true

bootstrap=/mnt/inbox/restore-bootstrap.env
if [[ -f "$bootstrap" ]] && grep -q '^AGENT_WARM_PREPARE=true$' "$bootstrap"; then
    configure_restore_host_alias "$bootstrap"
    configure_restore_network "$bootstrap" || exit 0
    printf '{"schema":1,"network_ready":true,"credential_free":true}\n' \
        >/mnt/inbox/warm-slot-ready.json
    chmod 600 /mnt/inbox/warm-slot-ready.json
    rm -f "$bootstrap"
    systemctl stop --no-block agent-client-restore-bootstrap.timer
elif [[ -f "$bootstrap" ]] && grep -q '^AGENT_BOOTSTRAP_TOKEN=' "$bootstrap"; then
    configure_restore_host_alias "$bootstrap"
    configure_restore_network "$bootstrap" || exit 0
    synchronize_restore_clock "$bootstrap" || exit 0
    wait_for_restore_enrollment_endpoint "$bootstrap" || exit 0
    tls_dir="$(sed -n 's/^AGENT_BOOTSTRAP_TLS_DIR=//p' "$bootstrap" | head -n1)"
    tls_dir="${tls_dir:-/etc/agentic-sandbox/grpc-mtls}"
    case "$tls_dir" in
        /etc/agentic-sandbox/grpc-mtls|/etc/agentic-sandbox/tls)
            install -d -m 0700 -o agent -g agent "$tls_dir"
            ;;
        *)
            echo "refusing unsafe bootstrap TLS directory: $tls_dir" >&2
            exit 1
            ;;
    esac
    systemctl start --no-block agent-client.service
    for _ in {1..40}; do
        [[ ! -e "$bootstrap" ]] && break
        systemctl is-failed --quiet agent-client.service && break
        sleep 0.025
    done
    systemctl is-failed --quiet agent-client.service && exit 1
    systemctl stop --no-block agent-client-restore-bootstrap.timer
fi
