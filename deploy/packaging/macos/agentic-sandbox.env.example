# Agentic Sandbox Apple Silicon workstation configuration.
# Copy selected values into the environment of the logged-in user that starts
# management. This file contains identifiers and defaults only, never secrets.

LISTEN_ADDR=127.0.0.1:8120
DOCKER_MONITOR_ENABLED=true

# Native host execution is disabled until the operator explicitly reviews the
# full-host-access warning, renders/loads the per-user LaunchAgent, and changes
# this value to 1.
AGENTIC_HOST_RUNTIME_ENABLED=0
AGENTIC_HOST_RUNTIME_MODE=daemon

# Explicit local CA and macOS Keychain root-key selection. The Keychain item is
# created by management in the logged-in user context; no private value belongs
# in this file.
AGENTIC_GRPC_CA_BACKEND=local
AGENTIC_GRPC_LOCAL_CA_KEY_STORE=macos-keychain
AGENTIC_GRPC_LOCAL_CA_KEYCHAIN_SERVICE=io.aiwg.agentic-sandbox.grpc-local-ca
AGENTIC_GRPC_LOCAL_CA_KEYCHAIN_ACCOUNT=root-key:sandbox.agentic.local

# Set SECRETS_DIR to an absolute owner-only directory under:
# ~/Library/Application Support/io.aiwg.agentic-sandbox/secrets
