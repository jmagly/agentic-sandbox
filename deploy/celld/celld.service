[Unit]
Description=Celld managed Worker node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=celld
Group=celld
DynamicUser=yes
StateDirectory=agentic-sandbox/celld
StateDirectoryMode=0700
EnvironmentFile=/etc/agentic-sandbox/celld/node.env
LoadCredential=object-store:/etc/agentic-sandbox/celld/object-store.credentials
Environment=AWS_SHARED_CREDENTIALS_FILE=%d/object-store
ExecStartPre=/usr/libexec/agentic-sandbox/agentic-celld-preflight --manifest /etc/agentic-sandbox/celld/fleet.json --celld /opt/agentic-sandbox/celld/v0.2.1/celld
ExecStart=/opt/agentic-sandbox/celld/v0.2.1/celld
Restart=on-failure
RestartSec=2s
NoNewPrivileges=true
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
UMask=0077

[Install]
WantedBy=multi-user.target
