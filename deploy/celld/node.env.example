# Copy to /etc/agentic-sandbox/celld/node.env and set node-specific values.
# Values must agree with fleet.json. Keep CELLD_STORAGE_PROBE enabled: it is
# Celld's own startup behavior check, not a qualification verdict.
CELLD_BUCKET=s3://replace-with-dedicated-celld-bucket/celld-poc/cells
AWS_REGION=us-east-1
CELLD_ADDR=0.0.0.0:443
CELLD_INTERNAL_ADDR=10.88.0.10:8124
CELLD_ADVERTISE=10.88.0.10:8124
CELLD_NODE=node-1
CELLD_WATCH=/var/lib/agentic-sandbox/celld/watch
CELLD_STORAGE_PROBE=1
AGENTIC_CELLD_EXPECTED_BINARY_SHA256=sha256:REPLACE_WITH_VERIFIED_BINARY_DIGEST
