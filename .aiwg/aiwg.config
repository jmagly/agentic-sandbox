{
  "$schema": "https://aiwg.io/schemas/aiwg.config.v1.json",
  "version": "1",
  "providers": [
    "claude",
    "codex"
  ],
  "project": {
    "name": "agentic-sandbox",
    "displayName": "Agentic Sandbox",
    "delivery": "direct",
    "defaultBranch": "main"
  },
  "delivery": {
    "mode": "direct",
    "default_branch": "main",
    "require_ci_green": true,
    "auto_close_issues": true,
    "force_push_policy": "never",
    "issue_comment_on_cycle": true,
    "rationale": "Single-maintainer direct delivery project; release flow still gates on local checks and CI."
  },
  "remotes": {
    "primary": "origin",
    "issue_tracker": "origin",
    "ci": "origin",
    "secondary": [
      {
        "name": "github",
        "purpose": "backup-mirror",
        "push_on_release": true
      }
    ]
  },
  "versioning": {
    "format": "calver",
    "pattern": "YYYY.M.PATCH",
    "tag_prefix": "v",
    "no_leading_zeros": true
  },
