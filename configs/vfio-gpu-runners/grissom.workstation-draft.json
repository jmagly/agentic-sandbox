{
  "schema": 1,
  "host_class": "grissom-workstation-local-only",
  "repository": "roctinam/agentic-sandbox",
  "allowed_ref": "refs/heads/main",
  "allowed_actors": ["roctinam"],
  "runner_label": "local-only",
  "lock_file": "/run/lock/agentic-sandbox-vfio-gpu.lock",
  "service_gpu": {
    "bdf": "0000:00:02.0",
    "native_driver": "i915"
  },
  "test_gpu": {
    "bdf": "0000:01:00.0",
    "iommu_group": "16",
    "group_members": ["0000:01:00.0", "0000:01:00.1"],
    "device_nodes": [
      "dri/card2",
      "dri/renderD129",
      "nvidia0",
      "nvidiactl",
      "nvidia-modeset"
    ],
    "native_drivers": {
      "0000:01:00.0": "nvidia",
      "0000:01:00.1": "snd_hda_intel"
    },
    "acs_reviewed": false
  },
  "validation": {
    "base_image": "/mnt/ops/base-images/ubuntu-server-24.04-agent.qcow2",
    "ssh_key": "/var/lib/agentic-sandbox/secrets/ssh-keys/vfio-validation",
    "ssh_user": "agent",
    "cpus": 4,
    "memory": "8G",
    "disk": "40G",
    "network": "default",
    "guest_functionality_command": "nvidia-smi -L",
    "residue_tool": "/usr/local/libexec/agentic-vfio-residue-probe"
  }
}
